    "custom_liquid_T9aAmQ": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign sale_price = current_variant.price %}\n{% assign original_price = current_variant.compare_at_price %}\n{% assign shipping_threshold = 30000 %}\n\n<div class=\"rynow-benefits\">\n  <div class=\"rynow-benefit\"><b>✓</b><span><strong>100% Genuine Products</strong><small>Authentic products from trusted brands</small></span></div>\n  <div class=\"rynow-benefit\"><b>✓</b><span><strong>Malaysia Local Warranty</strong><small>Local support when you need it</small></span></div>\n  <div class=\"rynow-benefit\"><b>✓</b><span><strong>Fast Nationwide Shipping</strong><small>Secure delivery across Malaysia</small></span></div>\n  <div class=\"rynow-benefit\"><b>↗</b><span>{% if sale_price >= shipping_threshold %}<strong>Free shipping unlocked</strong><small>This product qualifies for free nationwide shipping</small>{% else %}<strong>Free shipping above RM300</strong><small>Add more items to unlock free nationwide shipping</small>{% endif %}</span></div>\n</div>\n\n{% if original_price > sale_price %}\n  {% assign savings = original_price | minus: sale_price %}\n  <div class=\"rynow-savings\">Save {{ savings | money }} on this product</div>\n{% endif %}\n\n<style>\n.rynow-benefits{display:grid;gap:0;margin:24px 0;padding:8px 16px;border:1px solid rgba(0,0,0,.12);border-radius:12px;background:rgba(0,0,0,.03)}\n.rynow-benefit{display:flex;gap:12px;align-items:flex-start;padding:12px 0}\n.rynow-benefit+.rynow-benefit{border-top:1px solid rgba(0,0,0,.1)}\n.rynow-benefit b{display:grid;place-items:center;flex:0 0 22px;width:22px;height:22px;border-radius:50%;background:#111;color:#fff;font-size:13px}\n.rynow-benefit strong,.rynow-benefit small{display:block}\n.rynow-benefit small{margin-top:2px;opacity:.65}\n.rynow-savings{display:inline-block;margin:0 0 20px;padding:7px 11px;border-radius:999px;background:#e7f7ed;color:#08763f;font-weight:600;font-size:14px}\n</style>",
        "background_color": "{{ settings.color_palette.color4 }}",
        "section_width": "page-width",
        "padding-block-start": 42,
        "padding-block-end": 0
      }
