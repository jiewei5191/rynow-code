    "custom_liquid_NkLMaB": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n.feature-section{\n  max-width:1400px;\n  margin:120px auto;\n  padding:0 40px;\n}\n\n.feature-grid{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:80px;\n  align-items:center;\n}\n\n.feature-grid.reverse{\n  direction:rtl;\n}\n\n.feature-grid.reverse > *{\n  direction:ltr;\n}\n\n.feature-image img{\n  width:100%;\n  border-radius:24px;\n  display:block;\n}\n\n.feature-content .subtitle{\n  font-size:14px;\n  letter-spacing:2px;\n  text-transform:uppercase;\n  opacity:.6;\n  margin-bottom:12px;\n}\n\n.feature-content h2{\n  font-size:56px;\n  line-height:1;\n  margin:0 0 24px;\n  font-weight:700;\n}\n\n.feature-content .desc{\n  font-size:20px;\n  line-height:1.8;\n  opacity:.8;\n}\n\n.feature-dark{\n  background:#0a0a0a;\n  color:#fff;\n  padding:120px 0;\n}\n\n.feature-light{\n  background:#f5f5f7;\n  color:#111;\n  padding:120px 0;\n}\n\n.feature-full{\n  text-align:center;\n  max-width:1600px;\n  margin:auto;\n}\n\n.feature-full img{\n  width:100%;\n  border-radius:24px;\n}\n\n.feature-full .subtitle{\n  margin-top:60px;\n  font-size:14px;\n  letter-spacing:3px;\n  text-transform:uppercase;\n  opacity:.7;\n}\n\n.feature-full h2{\n  font-size:80px;\n  margin:20px 0;\n  line-height:1;\n}\n\n.feature-full .desc{\n  max-width:800px;\n  margin:auto;\n  font-size:22px;\n  line-height:1.8;\n}\n\n@media(max-width:768px){\n\n  .feature-grid{\n    grid-template-columns:1fr;\n    gap:40px;\n  }\n\n  .feature-grid.reverse{\n    direction:ltr;\n  }\n\n  .feature-content h2{\n    font-size:36px;\n  }\n\n  .feature-full h2{\n    font-size:48px;\n  }\n\n}\n</style>\n\n{% for item in product.metafields.custom.feature_blocks.value %}\n\n{% assign layout = item.layout | downcase %}\n{% assign bg = item.background | downcase %}\n\n<div class=\"{% if bg == 'dark' %}feature-dark{% else %}feature-light{% endif %}\">\n\n{% if layout == 'full' %}\n\n<div class=\"feature-section feature-full\">\n\n<img\nsrc=\"{{ item.image | image_url: width: 2000 }}\"\nalt=\"{{ item.title }}\"\n>\n\n<div class=\"subtitle\">\n{{ item.subtitle }}\n</div>\n\n<h2>\n{{ item.title }}\n</h2>\n\n<div class=\"desc\">\n{{ item.description | metafield_tag }}\n</div>\n\n</div>\n\n{% elsif layout == 'right' %}\n\n<div class=\"feature-section\">\n\n<div class=\"feature-grid reverse\">\n\n<div class=\"feature-image\">\n<img\nsrc=\"{{ item.image | image_url: width: 1600 }}\"\nalt=\"{{ item.title }}\"\n>\n</div>\n\n<div class=\"feature-content\">\n\n<div class=\"subtitle\">\n{{ item.subtitle }}\n</div>\n\n<h2>\n{{ item.title }}\n</h2>\n\n<div class=\"desc\">\n{{ item.description | metafield_tag }}\n</div>\n\n</div>\n\n</div>\n\n</div>\n\n{% else %}\n\n<div class=\"feature-section\">\n\n<div class=\"feature-grid\">\n\n<div class=\"feature-image\">\n<img\nsrc=\"{{ item.image | image_url: width: 1600 }}\"\nalt=\"{{ item.title }}\"\n>\n</div>\n\n<div class=\"feature-content\">\n\n<div class=\"subtitle\">\n{{ item.subtitle }}\n</div>\n\n<h2>\n{{ item.title }}\n</h2>\n\n<div class=\"desc\">\n{{ item.description | metafield_tag }}\n</div>\n\n</div>\n\n</div>\n\n</div>\n\n{% endif %}\n\n</div>\n\n{% endfor %}",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
