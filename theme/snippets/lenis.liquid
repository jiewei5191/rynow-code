{% comment %}
  Lenis smooth scroll (MIT, darkroom.engineering) — v1.3.27 via jsDelivr.
  Site-wide: weighted, buttery scroll. Disabled when the visitor prefers
  reduced motion, and no-ops if the CDN fails to load.
{% endcomment %}
<script src="https://cdn.jsdelivr.net/npm/lenis@1.3.27/dist/lenis.min.js" defer></script>
<script>
  window.addEventListener('load', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (typeof Lenis === 'undefined') return;
    var lenis = new Lenis({ autoRaf: true, duration: 1.15, smoothWheel: true });
    window.__rynowLenis = lenis;
    // Anchor links: smooth-scroll to the target instead of jumping.
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var hash = a.getAttribute('href');
      if (!hash || hash.length < 2) return;
      var target = document.querySelector(hash);
      if (target) {
        e.preventDefault();
        lenis.scrollTo(target);
      }
    });
  });
</script>
