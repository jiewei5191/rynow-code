{% stylesheet %}
  .rynow-hero-a2 {
    padding: 88px 0 96px;
    background: #ffffff;
    color: #1d1d1f;
    overflow: hidden;
  }

  .rynow-hero-a2__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .rynow-hero-a2__copy > * {
    animation: rynow-hero-a2-in 0.8s ease-out both;
  }

  .rynow-hero-a2__copy > *:nth-child(1) { animation-delay: 0s; }
  .rynow-hero-a2__copy > *:nth-child(2) { animation-delay: 0.1s; }
  .rynow-hero-a2__copy > *:nth-child(3) { animation-delay: 0.2s; }
  .rynow-hero-a2__copy > *:nth-child(4) { animation-delay: 0.3s; }
  .rynow-hero-a2__copy > *:nth-child(5) { animation-delay: 0.4s; }
  .rynow-hero-a2__copy > *:nth-child(6) { animation-delay: 0.5s; }

  @keyframes rynow-hero-a2-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .rynow-hero-a2__eyebrow {
    margin: 0 0 20px;
    color: #c9a86a;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .rynow-hero-a2__heading {
    margin: 0 0 20px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.01em;
  }

  .rynow-hero-a2__sub {
    max-width: 46ch;
    margin: 0 0 28px;
    color: #6e6e73;
    font-size: 18px;
    line-height: 1.6;
  }

  .rynow-hero-a2__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 28px;
  }

  .rynow-hero-a2__price-now {
    font-size: 26px;
    font-weight: 600;
  }

  .rynow-hero-a2__price-was {
    color: #6e6e73;
    font-size: 17px;
    text-decoration: line-through;
  }

  .rynow-hero-a2__colours {
    display: flex;
    gap: 20px;
    margin: 0 0 36px;
    padding: 0;
    list-style: none;
  }

  .rynow-hero-a2__colour {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .rynow-hero-a2__dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .rynow-hero-a2__dot--white { background: #f5f5f7; }
  .rynow-hero-a2__dot--black { background: #1d1d1f; }
  .rynow-hero-a2__dot--burgundy { background: #722f37; }
  .rynow-hero-a2__dot--sky { background: #9cc3e5; }

  .rynow-hero-a2__colour-label {
    color: #6e6e73;
    font-size: 13px;
    line-height: 1.3;
  }

  .rynow-hero-a2__cta {
    display: inline-block;
    padding: 14px 36px;
    border-radius: 999px;
    background: #0071e3;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .rynow-hero-a2__cta:hover {
    opacity: 0.85;
  }

  .rynow-hero-a2__media {
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
  }

  .rynow-hero-a2__media img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    animation: rynow-hero-a2-zoom 26s ease-in-out infinite alternate;
    transform-origin: 62% 50%;
  }

  @keyframes rynow-hero-a2-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rynow-hero-a2__copy > * {
      animation: none;
    }

    .rynow-hero-a2__media img {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .rynow-hero-a2 {
      padding: 64px 0 72px;
    }

    .rynow-hero-a2__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .rynow-hero-a2__sub {
      font-size: 16px;
    }

    .rynow-hero-a2__colours {
      margin-bottom: 28px;
    }
  }
{% endstylesheet %}

{% liquid
  assign hero_image = section.settings.image | image_url: width: 1400
  if hero_image == blank
    assign hero_image = 'https://cdn.shopify.com/s/files/1/0693/9230/2147/files/my-11134207-820l7-mu56rmx4o8aw23.jpg?v=1791651519'
  endif
%}

<section class="rynow-hero-a2">
  <div class="rynow-hero-a2__inner">
    <div class="rynow-hero-a2__copy">
      <p class="rynow-hero-a2__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="rynow-hero-a2__heading">{{ section.settings.heading }}</h1>
      <p class="rynow-hero-a2__sub">{{ section.settings.subheading }}</p>
      <p class="rynow-hero-a2__price">
        <span class="rynow-hero-a2__price-now">{{ section.settings.price }}</span>
        <span class="rynow-hero-a2__price-was">{{ section.settings.compare_at_price }}</span>
      </p>
      <ul class="rynow-hero-a2__colours">
        <li class="rynow-hero-a2__colour">
          <span class="rynow-hero-a2__dot rynow-hero-a2__dot--white" aria-hidden="true"></span>
          <span class="rynow-hero-a2__colour-label">White</span>
        </li>
        <li class="rynow-hero-a2__colour">
          <span class="rynow-hero-a2__dot rynow-hero-a2__dot--black" aria-hidden="true"></span>
          <span class="rynow-hero-a2__colour-label">Black</span>
        </li>
        <li class="rynow-hero-a2__colour">
          <span class="rynow-hero-a2__dot rynow-hero-a2__dot--burgundy" aria-hidden="true"></span>
          <span class="rynow-hero-a2__colour-label">Burgundy</span>
        </li>
        <li class="rynow-hero-a2__colour">
          <span class="rynow-hero-a2__dot rynow-hero-a2__dot--sky" aria-hidden="true"></span>
          <span class="rynow-hero-a2__colour-label">Sky Blue</span>
        </li>
      </ul>
      <a class="rynow-hero-a2__cta" href="{{ section.settings.button_link }}">
        {{- section.settings.button_label -}}
      </a>
    </div>
    <div class="rynow-hero-a2__media">
      <img
        src="{{ hero_image }}"
        alt="Godox A2 smartphone xenon flash — white"
        width="1024"
        height="1024"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "A2 hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Godox A2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stop Blaming Your iPhone."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A real xenon flash for your phone. Not a LED."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "RM271"
    },
    {
      "type": "text",
      "id": "compare_at_price",
      "label": "Compare-at price",
      "default": "RM339"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop A2"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": "https://rynow.co/products/godox-a2-smartphone-xenon-flash-ttl-hss-1-8000s-magnetic-flash-with-bi-color-led-light"
    }
  ],
  "presets": [
    {
      "name": "A2 hero"
    }
  ]
}
{% endschema %}
